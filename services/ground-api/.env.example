# Copia este archivo como .env para sobrescribir los valores por defecto.
PORT=4000
NODE_ENV=development

# Orígenes permitidos para Socket.IO si el dashboard NO usa el proxy de Vite (separados por comas)
SOCKET_CORS_ORIGINS=http://localhost:5173

# Rechazos recientes conservados en memoria para diagnóstico
REJECTED_LOG_SIZE=200
