# Copia este archivo como .env para sobrescribir los valores por defecto.
PORT=4001
# development | test | production. En production se desactivan los controles /api/dev.
NODE_ENV=development

# Ground API (comunicación nave → tierra por HTTP)
GROUND_API_URL=http://localhost:4000
GROUND_REQUEST_TIMEOUT_MS=5000

# Telemetría SIMULADA (0 = desactivada; se puede generar a mano con POST /api/dev/telemetry/tick)
TELEMETRY_INTERVAL_MS=5000
SIMULATION_SEED=42

# Cola de sincronización (0 = solo envío manual con POST /api/dev/sync/flush)
SYNC_INTERVAL_MS=1000
SYNC_BATCH_SIZE=50
SYNC_MAX_ATTEMPTS=10
SYNC_BACKOFF_BASE_MS=1000
SYNC_BACKOFF_MAX_MS=30000

# Enlace simulado: connected | degraded | disconnected
LINK_STATE=connected
LINK_LATENCY_MS=0
LINK_DEGRADED_LATENCY_MS=1500
LINK_DEGRADED_FAILURE_RATE=0.3

# Alertas (reglas DEMOSTRATIVAS, ver docs/alerts.md)
# Comprobación periódica de datos desactualizados (ms). 0 = desactivada.
ALERT_STALE_CHECK_MS=60000
# Cambios parciales a las reglas, en JSON. Vacío = valores por defecto.
ALERT_RULES_JSON=
